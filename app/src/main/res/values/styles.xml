<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextoTitulo">
        <item name="android:fontFamily">@font/Roboto-Bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:lineHeight">35sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextoCuerpo">
        <item name="android:fontFamily">@font/Roboto-Regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight">24sp</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextoBoton">
        <item name="android:fontFamily">@font/Roboto-Medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">20sp</item>
        <item name="android:textColor">@color/contenido_sobre_principal</item>
    </style>

    <style name="TextoBotonSecundario" parent="TextoBoton">
        <item name="android:textColor">@color/texto_boton_secundario</item>
    </style>
</resources>